# LSP Gateway Environment Configuration
# Copy this file to .env and modify as needed.
# Full reference: docs/ENVIRONMENT_VARIABLES.md

# Log level: trace, debug, info, warn, error
RUST_LOG=info

# Database
DATABASE_URL=postgresql://localhost/lsp_gateway
DATABASE_MAX_CONNECTIONS=10

# Server
SERVER_BIND_ADDRESS=0.0.0.0
SERVER_PORT=8080

# Redis
REDIS_URL=redis://localhost:6379
REDIS_MAX_CONNECTIONS=10
METRICS_REPORT_INTERVAL_SECONDS=3

# Cache
CACHE_MAX_CAPACITY=10000
CACHE_TTL_SECONDS=30

# Timeouts (milliseconds)
SERVER_RESPONSE_TIMEOUT_MS=55000
SERVER_STREAM_NO_TOKEN_TIMEOUT_MS=10000

# Retry
RETRY_MAX_RETRIES=3
RETRY_BASE_BACKOFF_MS=1000
RETRY_MAX_BACKOFF_MS=10000
RETRY_JITTER_ENABLED=true
RETRY_ON_RATE_LIMIT=true

# Routing
ROUTING_STRATEGY=smooth_weighted_round_robin

# Rate limiting (requires Redis)
RATE_LIMIT_ALGORITHM=token_bucket
BURST_MULTIPLIER=1.0

# Supervisor / adaptive traffic control (requires Redis)
SUPERVISOR_ENABLED=true
CIRCUIT_BREAKER_ENABLED=true

# Distributed tracing (OpenTelemetry -> OTLP endpoint)
TRACING_ENABLED=false
OTLP_TRACES_URL=http://localhost:4318
SERVICE_NAME=lsp-gateway
SERVICE_VERSION=0.1.0
TRACING_SAMPLING_RATIO=1.0
TRACING_DEBUG=false

# GrowthBook feature flags (optional)
GROWTHBOOK_ENABLED=false
GROWTHBOOK_HOST=https://cdn.growthbook.io
GROWTHBOOK_PROXY_HOST=https://cdn.growthbook.io
GROWTHBOOK_CLIENT_KEY=
GROWTHBOOK_REFRESH_INTERVAL_SECS=30
GROWTHBOOK_REFRESH_PROBABILITY=1000

# FRP reverse-proxy node discovery (optional)
FRP_ENABLED=false
FRP_URL=http://localhost:10086
FRP_PASSWD=
FRP_CONNS_LIMIT=50
# Domain suffix used to build per-node URLs, e.g. ".frp.example.com"
FRP_SERVER_SUFFIX=.frp.example.com
FRP_SCHEME=http

# Provider API keys (set only the providers you use)
# OPENAI_CHAT_API_KEY=
# OPENAI_NSFW_API_KEY=
# GOOGLE_AI_API_KEY=
# LEPTON_API_KEY=
# SONNET_API_KEY=
# SONNET_API_KEY_BACKUP=
# SONNET_API_KEY_BACKUP_2=
# OTHER_PROVIDER_1_API_KEY=
# OTHER_PROVIDER_2_API_KEY=
# DEEPSEEK_API_KEY=
# OPENROUTER_API_KEY=
# NOVITA_API_KEY=
# FEATHERLESS_API_KEY=
# PAINT_BOT_KEY=
